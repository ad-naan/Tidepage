{
  "name": "tidepage",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "realtime": "node --import tsx services/realtime/main.ts",
    "test:realtime": "node --conditions=react-server --import tsx --test tests/platform/realtime*.test.ts tests/platform/coast-realtime.test.ts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "check:architecture": "node scripts/check-boundaries.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "test": "node --conditions=react-server --import tsx --test tests/platform/*.test.ts tests/*.test.mjs",
    "check": "pnpm run format:check && pnpm run check:assets && pnpm run check:architecture && pnpm run typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db-migrate.ts",
    "db:check": "node --conditions=react-server --import tsx scripts/db-check.ts",
    "db:verify": "node --conditions=react-server --import tsx scripts/db-verify.ts",
    "db:studio": "drizzle-kit studio",
    "admin:setup": "node --conditions=react-server --import tsx scripts/admin-setup.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.1",
    "@fontsource/lxgw-wenkai-tc": "5.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@socket.io/redis-streams-adapter": "^0.3.1",
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-placeholder": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extension-task-item": "3.32.2",
    "@tiptap/extension-task-list": "3.32.2",
    "@tiptap/extension-typography": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/react": "3.32.2",
    "@tiptap/starter-kit": "3.32.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "next": "^16.0.0",
    "next-intl": "^4.14.9",
    "pg": "^8.23.1",
    "pixi.js": "8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "6.2.4",
    "redis": "^6.3.1",
    "refractor": "^5.0.0",
    "roughjs": "4.6.4",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.31.11",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.16.1 <13"
  }
}
