# Copy to .env. These are local development settings.
SITE_URL=http://localhost:3000
# demo works without any external service. Switch explicitly after migrating/seeding.
CONTENT_SOURCE=demo
INDEXING_ENABLED=false

# Set a local password before using docker compose.
POSTGRES_PASSWORD=change-this-local-password
# Uncomment after starting PostgreSQL; replace the password with your local value.
# DATABASE_URL=postgresql://adnaan:change-this-local-password@localhost:5432/adnaan
DATABASE_POOL_MAX=10
# Optional cache; an unavailable cache is bypassed, an unavailable database is not.
# REDIS_URL=redis://localhost:6379
CACHE_NAMESPACE=adnaan:local:v1
CACHE_TTL_SECONDS=60
