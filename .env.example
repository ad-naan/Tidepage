# Copy to .env. These are local development settings.
SITE_URL=http://localhost:3000
INDEXING_ENABLED=false

DATABASE_URL=postgresql://adnaan:change-this-local-password@localhost:5432/adnaan
DATABASE_POOL_MAX=10
# Local filesystem resources; public URLs use /uploads/<content-hash>.<ext>.
UPLOAD_DIR=./storage/uploads
# Frontend and workbench share GitHub/Gitee OAuth. Configure either or both pairs.
# Development: .env.local; Docker: deployment .env.
# Callback: <SITE_URL>/api/v1/auth/github/callback (or /gitee/callback).
# Bind owner: pnpm admin:setup --github <username> --gitee <username>
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_GITEE_CLIENT_ID=
# OAUTH_GITEE_CLIENT_SECRET=
# Optional cache; an unavailable cache is bypassed, an unavailable database is not.
# REDIS_URL=redis://localhost:6379
CACHE_NAMESPACE=adnaan:local:v1
CACHE_TTL_SECONDS=60

# Standalone Socket.IO gateway (pnpm realtime). Never expose the author token via NEXT_PUBLIC_.
REALTIME_HOST=127.0.0.1
REALTIME_PORT=3101
REALTIME_ORIGINS=http://localhost:3000
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Shared privately by Next.js and the gateway for author auth and coastal proofs.
# REALTIME_AUTHOR_TOKEN=
# NEXT_PUBLIC_REALTIME_URL=http://localhost:3101

# Docker deployment (compose.yaml) uses external PostgreSQL / Redis.
# Gateway Redis must be noeviction; see docs/deployment.md.
# TIDEPAGE_DOMAIN=example.com
# REALTIME_REDIS_URL=redis://:password@realtime-redis-host:6379
