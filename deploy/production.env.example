# 复制为项目根目录 .env，替换占位值；不要覆盖已有凭据，不要提交生产 .env。
# 对外 HTTPS 由 CDN 提供；回源为 base-nginx:80。
SITE_URL=https://adnaan.site
# extends 会校验原 compose.yaml 的变量；保留此项，但不会启动其中的 nginx。
TIDEPAGE_DOMAIN=adnaan.site
NEXT_PUBLIC_REALTIME_URL=https://adnaan.site
REALTIME_ORIGINS=https://adnaan.site

# 沿用已经存有新站数据的账号、密码和数据库名，仅改为容器内网地址。
# 用户名和密码分别做 URL 百分号编码；单引号避免 Compose 对 $ 做插值。
DATABASE_URL='postgresql://REPLACE_USER:REPLACE_ENCODED_PASSWORD@base-pg:5432/REPLACE_EXISTING_DATABASE'
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# 使用现有 Redis；如使用 ACL 用户，填写 redis://USER:PASSWORD@...。
REDIS_URL='redis://:REPLACE_ENCODED_PASSWORD@base-redis:6379/0'
REALTIME_REDIS_URL='redis://:REPLACE_ENCODED_PASSWORD@base-redis:6379/0'
REDIS_CONNECT_TIMEOUT_MS=3000
CACHE_NAMESPACE=adnaan:prod:v1
CACHE_TTL_SECONDS=60

# Web / 网关 / 桌面助手共用。生成：openssl rand -hex 32
REALTIME_AUTHOR_TOKEN=REPLACE_WITH_RANDOM_TOKEN

# 初次验证完成后可启用索引；开启后重新创建 Web 容器。
INDEXING_ENABLED=false

# 至少配置一种登录方式，必须是生产域名对应的 OAuth 应用。
# 回调：https://adnaan.site/api/v1/auth/gitee/callback
OAUTH_GITEE_CLIENT_ID=
OAUTH_GITEE_CLIENT_SECRET=
# 回调：https://adnaan.site/api/v1/auth/github/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# 可选 AI 配置可从 .env.example 追加；compose.yaml 已列出支持的变量。
